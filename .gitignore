# ---- Python environment (never commit the 1.5 GB venv) ----
brainsafe_env/
__pycache__/
*.pyc
*.pyo

# ---- Large trained-model binaries (regenerable from released scripts; host on Zenodo) ----
# All model binaries anywhere in the tree (RF pipeline ~1.2 GB, legacy models, etc.)
*.joblib
figures/_oof_cache.npz
*.npz

# ---- Large external structure libraries (regenerable from cluster + integrate_external.py) ----
# All .tsv structure dumps (DrugBank/COCONUT/ChEMBL34/natural); our modelling tables are .csv
*.tsv
*.sdf
data/external/processed/natural_products_coverage.csv

# keep the small metadata / reports that document the models
!models_brain/*_meta.json
!models_brain/*_conformal.json
!models_brain/*.json
!models_brain_reg/*_meta.json
!models_brain_reg/*.json
!models_genuine/*_meta.json
!models_v5/*.json

# ---- Raw API caches ----
# These are committed deliberately. They are the only record of what ChEMBL, BindingDB and
# PubChem returned on the retrieval dates, and the live APIs will not return the same rows
# after the next release. Without them the endpoint tables cannot be regenerated at all.
# ---- Logs, backups, scratch ----
logs/
*.log
*.bak
*.lowercase_bak
*.pre_druggability_bak
*.all529_bak
_*.py
scratchpad/
.DS_Store

# ---- Superseded / extracted / archive folders (keep repo clean) ----
old_version_extracted/
new_improvements_extracted/
run_order_extracted/
run_order.zip
manuscript_final/
BrainSafe_Supplementary/

# Claude Code local settings
.claude/
archive/legacy/_bulky/
.ipynb_checkpoints/

# Derived artifacts, regenerable from source scripts (large)
models_rf/ad_reference.pkl
models_rf/ad_per_endpoint.pkl
models_rf/holdout/

# Staged copies for the archived legacy app, not part of the deployed tool
archive/legacy/app/BS_compounds_full.json
archive/legacy/app/BS_compounds_ml_merged.json
archive/legacy/app/erc_ml.json

# Generated HTML previews (regenerable, large)
docs/app_preview.html
docs/about_preview.html

# Read-across index (regenerable via src/brainsafe/build_readacross_index.py)
models_rf/readacross_index.pkl

# Inversion analysis intermediate logs (results CSVs and REPORT.md are tracked)
inversion/*.log
inversion/results/H4_distant_predictions.csv

# Packaged model archive: published to Zenodo, never committed (0.79 GB)
dist/
models_rf_uncompressed/

# ---- Consolidated archive (see ARCHIVE_MANIFEST.csv, which IS committed) ----
# Everything superseded lives in one dated folder: the July publication bundle, the 2026-07-20
# legacy archive, build intermediates, run logs and the unused literature. Roughly 4 GB, all of it
# either regenerable or already in git history, so the folder stays local and the manifest travels.
_ARCHIVE_*/
